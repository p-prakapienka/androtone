      </GROUP>
    </GROUP>
    <GROUP id="{6E1F1C55-3C7B-4E0B-9A21-0C1D2B3A4F03}" name="app">
      <FILE id="LyApMn" name="Main.cpp" compile="1" resource="0" file="source/app/Main.cpp"/>
      <FILE id="LyApCh" name="MainComponent.h" compile="0" resource="0" file="source/app/MainComponent.h"/>
      <FILE id="LyApCc" name="MainComponent.cpp" compile="1" resource="0" file="source/app/MainComponent.cpp"/>
    </GROUP>
  </MAINGROUP>
  <MODULES>
    <MODULE id="juce_audio_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
